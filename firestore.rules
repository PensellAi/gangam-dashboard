rules_version = '2';
// Gangam store - Firestore security rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['ahmedassemads@gmail.com', 'shepamohamed@gmail.com'];
    }

    // Menu, prices and settings: anyone reads, only the admin writes
    match /catalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo codes: a customer can check one code; only the admin can list or edit
    match /promos/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    function validOrder(id) {
      let d = request.resource.data;
      return id.matches('^GG-[A-Z0-9]{6,12}$')
        && d.keys().hasOnly(['customer', 'payment', 'cart', 'promoCode', 'totals', 'status', 'hasShot', 'createdAt'])
        && d.status == 'new'
        && d.createdAt == request.time
        && d.payment in ['cod', 'vodafone', 'instapay']
        && d.hasShot is bool
        && (d.payment == 'cod' || d.hasShot == true)
        && d.customer.keys().hasOnly(['name', 'phone', 'address', 'notes'])
        && d.customer.name is string && d.customer.name.size() >= 2 && d.customer.name.size() <= 80
        && d.customer.phone is string && d.customer.phone.matches('^01[0125][0-9]{8}$')
        && d.customer.address is string && d.customer.address.size() >= 8 && d.customer.address.size() <= 400
        && d.customer.notes is string && d.customer.notes.size() <= 300
        && d.promoCode is string && d.promoCode.size() <= 30
        && d.cart is list && d.cart.size() > 0 && d.cart.size() <= 40
        && d.totals.total is number && d.totals.total > 0;
    }

    // Orders: customers can only create; only the admin reads and changes status
    match /orders/{id} {
      allow create: if validOrder(id);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'confirmed', 'shipped', 'delivered', 'cancelled'];
    }

    // Order pings: total, item count and payment method only; the push server reads one by id to confirm a real order
    match /orderPings/{id} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['total', 'count', 'payment', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.total is number
        && request.resource.data.count is number
        && request.resource.data.payment in ['cod', 'vodafone', 'instapay']
        && getAfter(/databases/$(database)/documents/orders/$(id)).data.totals.total == request.resource.data.total;
      allow delete: if isAdmin();
    }

    // Payment screenshots: uploaded together with the order, only the admin reads
    match /orderShots/{id} {
      allow create: if request.resource.data.keys().hasOnly(['img'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 950000
        && getAfter(/databases/$(database)/documents/orders/$(id)).data.hasShot == true;
      allow read, delete: if isAdmin();
    }
  }
}
